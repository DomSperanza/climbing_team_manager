    "vitest": "^5.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export -p web && node scripts/finish-web.mjs",
    "build:apk": "node scripts/check-release.mjs && expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "studio": "bash scripts/android-studio.sh",
    "template": "node scripts/embed-template.mjs",
    "build:aab": "node scripts/check-release.mjs --play && expo prebuild --platform android --no-install && cd android && ./gradlew bundleRelease",
