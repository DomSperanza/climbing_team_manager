# Copy to .env.local and fill in (see README.md → "Google Cloud setup").
# Client IDs are not secrets — every installed app and web page contains its client ID.
# Rebuild the app after changing these; they are baked into the build.

# The "Web application" OAuth client. Android sign-in and the web version both use it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The "iOS" OAuth client (only needed for the iPhone build).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
